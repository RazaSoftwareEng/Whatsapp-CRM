# =============================================================================
# WhatsApp CRM — Production environment
# Copy to .env.production on the VPS, fill in every value, then: chmod 600 .env.production
# =============================================================================

# --- Django core ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=crm.yourdomain.com
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://crm.yourdomain.com

# --- Database (Postgres — used by docker-compose.prod.yml) ---
DB_ENGINE=postgres
DB_NAME=whatsapp_crm_db
DB_USER=crm_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://redis:6379/0

# --- WhatsApp Cloud API (Meta Business setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# --- Frontend base URL (used to build invite/setup-password links in emails) ---
FRONTEND_URL=https://crm.yourdomain.com
