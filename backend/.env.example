SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DB_ENGINE=sqlite for local dev (no install needed).
# Switch to postgres once you have it available.
DB_ENGINE=sqlite
# DB_NAME=whatsapp_crm
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# WhatsApp Cloud API — fill these in during Phase 2 (Meta Business setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Email — console backend for local dev (prints to the runserver console).
# Switch EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend + fill EMAIL_HOST*
# once you have real SMTP creds.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Frontend base URL — used to build invite/setup-password links in outgoing emails
FRONTEND_URL=http://localhost:3000
